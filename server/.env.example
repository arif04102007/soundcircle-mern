# Server
PORT=3001
NODE_ENV=development

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/soundcircle locally)
MONGODB_URI=mongodb://127.0.0.1:27017/soundcircle

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Optional: your own TURN server for listeners behind strict NATs (falls back to a public relay)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
